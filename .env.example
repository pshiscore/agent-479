# Copy to .env.local for local development. Never commit real values.

# --- Site & bot identity -----------------------------------------------------
# The site's public origin, locally and in production: the bot's user agent
# links to <SITE_URL>/bot.
SITE_URL=https://479.guide
# Contact address sent in every fetch request:
#   User-Agent: Agent479Bot/1.0 (+<SITE_URL>/bot; <BOT_CONTACT_EMAIL>)
# Fetchers refuse to run when this or SITE_URL is empty.
BOT_CONTACT_EMAIL=bot@479.guide

# --- Site lock (src/proxy.ts) -------------------------------------------------
# "true": every page needs the preview login (except /bot and /robots.txt),
# responses are noindex, and robots.txt disallows everything. Production is
# locked unless this is exactly "false"; elsewhere only when it's "true".
SITE_LOCKED=
# The preview login, shareable with coworkers; separate from the admin login.
SITE_PREVIEW_USER=
SITE_PREVIEW_PASSWORD=
# Search engines are a separate switch: noindex and a Disallow-all robots.txt
# stay unless the site is unlocked, in production, and this is exactly "true".
SITE_INDEXING=

# --- Database ----------------------------------------------------------------
# Local development uses Postgres on this machine (src/lib/db/target.ts refuses
# anything else outside production):
#   DATABASE_URL=postgresql://localhost:5432/agent479_dev
#   DATABASE_URL_UNPOOLED=postgresql://localhost:5432/agent479_dev
# Production (Vercel, and .env.production.local for deliberate migrations)
# uses the Supabase project:
# Transaction pooler (Supavisor, port 6543), used by the app and cron jobs.
# The client must set prepare: false.
DATABASE_URL=
# Direct or session connection (port 5432), used only by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=

# --- Cron --------------------------------------------------------------------
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/*.
CRON_SECRET=
# Scheduled jobs run only when this is exactly "true". Production keeps it
# "false" until launch; the cron routes then log "disabled" and return.
CRON_ENABLED=false

# --- Admin (Basic Auth on /admin/*) ------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- LLM ---------------------------------------------------------------------
# Model names and prices live in the llm_models table, not here.
OPENAI_API_KEY=
# Hard daily spend cap. The LLM wrapper refuses calls once it is reached.
LLM_DAILY_BUDGET_USD=5

# --- Sources -----------------------------------------------------------------
TICKETMASTER_API_KEY=

# --- Later phases (unused in Phase 1) ----------------------------------------
SLACK_WEBHOOK_URL=
